# ~/.bashrc

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Reset user's systemd environment vars
_envgen=/usr/lib/systemd/user-environment-generators/30-systemd-environment-d-generator
if [ -z "$__SHELL_ENV_IMPORTED" ] && [ -x "$_envgen" ]; then
  while IFS= read -r _l; do
    [ -n "$_l" ] && eval "export $_l"
  done < <("$_envgen")
  _dedup=; _oifs=$IFS; IFS=:
  for _d in $PATH; do
    case ":$_dedup:" in *":$_d:"*) ;; *) _dedup=${_dedup:+$_dedup:}$_d ;; esac
  done
  IFS=$_oifs; export PATH="$_dedup" __SHELL_ENV_IMPORTED=1
  unset _dedup _oifs _d
fi
unset _envgen _l

alias grep='grep --color=auto'
alias ls='ls --color=auto'
alias vim='nvim'
alias wezterm='/home/scott/Applications/Wezterm/wezterm/target/release/wezterm --config-file /home/scott/.config/wezterm/wezterm.lua'

PS1='[\u@\h \W]\$ '

# Ruby user gem binaries
for _gem_bin in "$HOME/.local/share/gem/ruby/"*/bin; do
    [ -d "$_gem_bin" ] || continue
    case ":$PATH:" in
        *":$_gem_bin:"*) ;;
        *) export PATH="$_gem_bin:$PATH" ;;
    esac
done
unset _gem_bin

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"                   # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion" # This loads nvm bash_completion

# A tmux pane inherits SSH_CONNECTION at creation and keeps it forever, so
# panes restored by continuum at boot never see one, and panes outlive the
# client that created them. tmux refreshes the session environment on every
# client attach (update-environment), so pull the live value from there each
# prompt. Mirror of ~/.config/fish/conf.d/tmux_ssh_env.fish.
__tmux_sync_ssh_env() {
    [[ -n $TMUX ]] || return

    local entry
    entry=$(tmux show-environment SSH_CONNECTION 2>/dev/null)
    if [[ $entry == SSH_CONNECTION=* ]]; then
        export SSH_CONNECTION="${entry#SSH_CONNECTION=}"
    else
        unset SSH_CONNECTION
    fi
}

if [[ ";${PROMPT_COMMAND[*]:-};" != *";__tmux_sync_ssh_env;"* ]]; then
    if [[ "$(declare -p PROMPT_COMMAND 2>&1)" == "declare -a"* ]]; then
        PROMPT_COMMAND=(__tmux_sync_ssh_env "${PROMPT_COMMAND[@]}")
    else
        PROMPT_COMMAND="__tmux_sync_ssh_env${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
    fi
fi

eval "$(direnv hook bash)"

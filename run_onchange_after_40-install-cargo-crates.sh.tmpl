#!/usr/bin/env bash
# Install cargo managed binaries.
set -euo pipefail

export PATH="${HOME}/.cargo/bin:${PATH}"

command -v cargo >/dev/null || { echo "cargo not found; skipping crate install"; exit 0; }

# Install sccache.
command -v sccache >/dev/null || { echo "cargo install sccache"; RUSTC_WRAPPER= cargo install sccache --locked; }

while IFS= read -r crate; do
    [ -n "$crate" ] || continue
    { echo "cargo install ${crate}"; cargo install "$crate" --locked; }
done <<'CRATES'
{{ includeTemplate "cargo-crates.txt" . }}
CRATES

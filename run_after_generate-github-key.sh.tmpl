#!/usr/bin/env bash
# Generate a github ed25519 key.

set -euo pipefail

command -v ssh-keygen >/dev/null || exit 0
[ -f "$HOME/.ssh/github_ed25519" ] && exit 0

mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"
ssh-keygen -t ed25519 -a 100 \
  -C "scottfones@{{ .chezmoi.hostname }}-github-$(date +%F)" \
  -f "$HOME/.ssh/github_ed25519"
echo "generated $HOME/.ssh/github_ed25519. remember to add on GitHub as auth and signing"

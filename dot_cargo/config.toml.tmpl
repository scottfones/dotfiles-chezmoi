{{ if eq .chezmoi.arch "arm64" -}}
[build]
rustc-wrapper = "sccache"

[target.aarch64-unknown-linux-gnu]
rustflags = ["-C", "target-cpu=native"]

# Fat LTO with a single codegen unit is too slow and memory-hungry on a Pi 4.
[profile.release]
lto = "thin"
{{- else -}}
[build]
rustc-wrapper = "sccache"

[target.x86_64-unknown-linux-gnu]
rustflags = ["-C", "target-cpu=native"]

[profile.release]
lto = true
codegen-units = 1
{{- end }}

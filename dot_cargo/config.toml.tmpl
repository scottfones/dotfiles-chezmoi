{{ if eq .chezmoi.arch "arm64" -}}
[build]
rustc-wrapper = "sccache"

[target.aarch64-unknown-linux-gnu]
rustflags = ["-C", "target-cpu=native"]

[profile.release]
lto = "thin"
{{- else -}}
[build]
rustc-wrapper = "sccache"

[target.x86_64-unknown-linux-gnu]
rustflags = ["-C", "target-cpu=native", "-C", "link-arg=-fuse-ld=mold"]

[profile.dev.package."*"]
opt-level = 3

[profile.release]
lto = "fat"
codegen-units = 1
{{- end }}
